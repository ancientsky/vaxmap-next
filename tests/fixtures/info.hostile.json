   "id": "103106",
   "key": "coins",
   "hash": "sha256:d280e209b1609969",
   "title": "<script>alert('t')</script>Coins",
   "updated": "2026-09-23",
   "translated": true,
   "blocks": [
    {
     "type": "p",
     "text": "From October 1, 2026, adults aged 18 and over can earn “Health Coins” by completing designated health tasks such as health check-ups, cancer screenings and vaccinations. Coins can be redeemed for health products from December 1."
    },
    {
     "type": "p",
     "text": "Completing designated vaccinations also earns a “vaccine bonus”: 450 coins for the flu vaccine, 900 for a COVID-19 vaccine and 600 for a pneumococcal vaccine. Protect your health and collect rewards at the same time!"
    },
    {
     "type": "p",
     "text": "For details, see the Health Promotion Administration Health Coin website",
     "runs": [
      {
       "text": "For details, see the "
      },
      {
       "text": "Health Promotion Administration Health Coin website",
       "href": "https://www.healthtoken.hpa.gov.tw/"
      }
     ]
    },
